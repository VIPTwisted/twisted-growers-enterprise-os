*.log
.env
.env.*
.mcp.json
# ...and every variant of it. A .mcp.json.hidden appeared in the working tree on 10 Aug 2026
# while an agent was running `git add -A`; the exact name `.mcp.json` did not match it, so a
# file holding the live read-only Postgres URI was one wildcard away from GitHub. A credential
# committed is exposed RETROACTIVELY - git keeps the history, and only rotation undoes it.
.mcp.json*
bridge/token.txt*
bridge/bridge.err.log
bridge/bridge.log
bridge/token.txt
dist/
env/
node_modules/
workbook_extract/
__pycache__/
*.pyc

# Netlify CLI state — build artefact, never source (added 8 Aug 2026)
app/web/.netlify/
# Python bytecode from tools/
**/__pycache__/
# Downloaded PDF cache for the document parsers — regenerable from storage
tools/documents/.cache/

# Migrations whose recorded statements contain live credentials. The mirror in
# tools/sync-migrations.mjs rewrites them from schema_migrations on every run, so they
# are ignored by name rather than deleted. Rotate the keys, scrub the recorded
# statements in the database, then remove these lines.
supabase/migrations/20260805154324_metrc_auto_sync_schedule.sql
supabase/migrations/20260805173721_metrc_reference_tables_and_schedule.sql
supabase/migrations/20260807224411_permanent_document_urls_no_expiry_anywhere.sql
supabase/migrations/20260805215014_vincent_user_and_ai_budget.sql
