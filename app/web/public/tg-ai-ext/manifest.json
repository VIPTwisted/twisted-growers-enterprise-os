{
  "manifest_version": 3,
  "name": "TG Bots",
  "version": "1.2.0",
  "description": "Twisted Growers OS — answer Staff and Budz from the Grok, Claude, GPT or Grok Bots tab you already pay for. Pick the provider and the version your subscription offers. No extra API bill.",
  "key": "",
  "action": {
    "default_title": "TG Bots",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://fxetuqjryttnypgepsru.supabase.co/*",
    "https://twisted-growers-enterprise-os.netlify.app/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://grok.x.ai/*",
    "https://x.ai/*",
    "https://*.x.ai/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://claude.ai/*",
    "https://www.claude.ai/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "externally_connectable": {
    "matches": [ "https://twisted-growers-enterprise-os.netlify.app/*" ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://grok.x.ai/*",
        "https://x.ai/*",
        "https://*.x.ai/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://claude.ai/*",
        "https://www.claude.ai/*",
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https://fxetuqjryttnypgepsru.supabase.co"
  }
}
